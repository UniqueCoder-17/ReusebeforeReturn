# ============================================================
# Reuse Before Return — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# --- Supabase (Frontend) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# --- App URLs ---
VITE_APP_URL=http://localhost:5173

# --- Default Map Center (Hyderabad, Telangana) ---
VITE_DEFAULT_CITY=Hyderabad
VITE_DEFAULT_STATE=Telangana
VITE_DEFAULT_LAT=17.3850
VITE_DEFAULT_LNG=78.4867

# --- Supabase (Server-side only — never expose in frontend) ---
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- SMTP Email Configuration ---
# Required for email notifications
# Example: Gmail SMTP, Zoho Mail, Mailgun SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Reuse Before Return" <noreply@reusebeforereturn.in>

# --- Server Port (default: 3001) ---
SERVER_PORT=3001
